DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
SECRET_KEY=replace-with-a-long-random-string

# --- admin bootstrap (created on first run if absent) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_NOTIFY_ON_STATUS=true

# --- Paynow Zimbabwe ---
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
PAYNOW_RESULT_URL=https://your-domain.up.railway.app/api/paynow/result
PAYNOW_RETURN_URL=https://your-domain.up.railway.app/orders

# --- landed-cost defaults (overridden by Admin -> Brand & settings) ---
DUTY_RATE=0.20
VAT_RATE=0.15
SURTAX_RATE=0.05

# --- behaviour ---
SEED_DEMO_DATA=false
SESSION_COOKIE_SECURE=true
VITE_DEV=0
